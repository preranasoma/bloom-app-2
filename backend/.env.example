# ─── Flask backend env vars ───
# Copy to .env and fill in real values. NEVER commit .env to git.

# Secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# Database connection. Local SQLite by default; Render injects a Postgres URL.
DATABASE_URL=sqlite:///bloom.db

# Comma-separated origins allowed to call /api/*
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Port. Render sets PORT automatically; locally we default to 5001.
PORT=5001
